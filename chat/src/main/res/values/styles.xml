<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorBackgroundFloating">@color/surface</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/mist</item>
    </style>

    <!-- 平面浅色顶栏：深色文字与图标 -->
    <style name="AppTheme.Appbar">
        <item name="actionMenuTextColor">@color/menu_text_color</item>
        <item name="overlapAnchor">false</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="colorControlNormal">@color/ink</item>
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- 主页面大标题（参考图 Messages 的重量感） -->
    <style name="ToolbarTitle.Main" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- 二级页 Toolbar 标题 -->
    <style name="ToolbarTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!--全屏样式-->
    <style name="AppTheme.FullScreen">
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- 媒体预览：半透明窗口，下滑关闭时可透出下层聊天页 -->
    <style name="AppTheme.FullScreen.Translucent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!--自定义CheckBox样式-->
    <style name="CustomCheckboxTheme" parent="@android:style/Widget.CompoundButton.CheckBox">
        <item name="android:button">@drawable/checkbox_style</item>
    </style>

    <!--实下滑线样式-->
    <style name="Line">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:background">@color/line</item>
    </style>

    <!--选项条目样式-->
    <style name="OptionItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@color/surface</item>
    </style>

    <!--应用统一弹窗样式：无标题栏、透明窗口背景，圆角由卡片 drawable 提供。
        FshareDialog / FshareLoadingDialog / ServerInfoDialog 共用。-->
    <!--父主题必须用 DayNight 版本：Dialog(Context, themeResId) 会把整条父链的主题属性
        以 force=true 盖到 Activity 主题上，固定深色父主题会让 RadioButton/ProgressBar/ripple
        这些靠主题属性取色的控件在浅色模式下取到深色配色（未选中圆环几乎不可见等）。
        这里显式指定控件色，跟随本项目的 token（values/colors.xml 与 values-night/colors.xml 会自动适配深浅色）。-->
    <style name="FshareDialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="colorAccent">@color/cobalt</item>
        <item name="android:colorControlNormal">@color/mist</item>
        <item name="colorControlNormal">@color/mist</item>
        <item name="colorControlActivated">@color/cobalt</item>
    </style>

    <!--底部弹出菜单：让 material 的 BottomSheetDialog 容器透明，圆角交给 bg_dialog_sheet-->
    <style name="FshareBottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/FshareBottomSheetStyle</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="colorAccent">@color/cobalt</item>
    </style>

    <style name="FshareBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

</resources>
