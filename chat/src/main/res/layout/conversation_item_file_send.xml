<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"  xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fileMessageContentItemView"
    android:layout_width="wrap_content"
    android:layout_height="100dp"
    android:minWidth="250dp"
    android:adjustViewBounds="true"
    android:padding="2dp"
    android:background="@drawable/img_bubble_send"
    android:scaleType="fitCenter">

    <cn.wildfire.chat.kit.widget.BubbleImageView
        android:id="@+id/fileIconImageView"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_file"
        app:bubble_angle="5dp"
        app:bubble_arrowHeight="0dp"
        app:bubble_arrowLocation="right"
        app:bubble_arrowOffset="0dp"
        app:bubble_arrowTop="0dp"
        app:bubble_arrowWidth="2dp"
        />

    <TextView
        android:id="@+id/fileNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/fileIconImageView"
        android:layout_marginLeft="0dp"
        android:layout_marginTop="9dp"
        android:layout_marginRight="10dp"
        android:layout_toRightOf="@id/fileIconImageView"
        android:maxWidth="200dp"
        android:textSize="14sp"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="1"
        android:scrollHorizontally="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        tools:text="测试文件名称萨的发色" />

    <TextView
        android:id="@+id/fileSizeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/fileIconImageView"
        android:layout_marginLeft="0dp"
        android:layout_marginBottom="10dp"
        android:layout_toRightOf="@id/fileIconImageView"
        android:maxLines="1"
        android:text="20.15M"
        android:textSize="12sp" />

</RelativeLayout>
