<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:tools="http://schemas.android.com/tools"  xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fileMessageContentItemView"
    android:layout_width="wrap_content"
    android:layout_height="100dp"
    android:minWidth="250dp"
    android:adjustViewBounds="true"
    android:padding="2dp"
    android:background="@drawable/shape_bubble_receive"
    android:scaleType="fitCenter">

    <!--文件类型图标：按类型着色的圆角块 + 类型文字，上层保留 BubbleImageView 承载下载进度与点击-->
    <FrameLayout
        android:id="@+id/fileIconFrameLayout"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_centerVertical="true">

        <TextView
            android:id="@+id/fileTypeTextView"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:background="@drawable/shape_file_type_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            tools:text="PDF" />

        <cn.wildfire.chat.kit.widget.WaveProgressView
            android:id="@+id/fileDownloadWaveView"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <cn.wildfire.chat.kit.widget.BubbleImageView
            android:id="@+id/fileIconImageView"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@android:color/transparent"
            app:bubble_angle="10dp"
            app:bubble_arrowHeight="0dp"
            app:bubble_arrowLocation="right"
            app:bubble_arrowOffset="0dp"
            app:bubble_arrowTop="0dp"
            app:bubble_arrowWidth="2dp" />
    </FrameLayout>

    <TextView
        android:id="@+id/fileNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/fileIconFrameLayout"
        android:layout_marginLeft="0dp"
        android:layout_marginTop="9dp"
        android:layout_marginRight="10dp"
        android:layout_toRightOf="@id/fileIconFrameLayout"
        android:maxWidth="200dp"
        android:textSize="14sp"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="1"
        android:scrollHorizontally="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:textColor="@color/message_text_receive_dark"
        tools:text="测试文件名称萨的发色" />

    <TextView
        android:id="@+id/fileSizeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/fileIconFrameLayout"
        android:layout_marginLeft="0dp"
        android:layout_marginBottom="10dp"
        android:layout_toRightOf="@id/fileIconFrameLayout"
        android:maxLines="1"
        android:textSize="12sp"
        android:textColor="@color/mist"
        tools:text="20.15M" />

    <!--下载状态：紧跟文件大小右侧，未下载/下载中 xx%/已下载-->
    <TextView
        android:id="@+id/fileStatusTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/fileSizeTextView"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="10dp"
        android:layout_toRightOf="@id/fileSizeTextView"
        android:maxLines="1"
        android:textSize="12sp"
        android:textColor="@color/mist"
        tools:text="未下载" />

</RelativeLayout>
