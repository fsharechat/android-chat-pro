<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp">

    <!--个人信息卡片-->
    <LinearLayout
        android:id="@+id/meLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_surface_card"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/portraitImageView"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/default_header" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:text="wfc"
                android:textColor="@color/ink"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/accountTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:text="@string/my_chat_account"
                android:textColor="@color/mist"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!--选项卡片-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/shape_surface_card"
        android:orientation="vertical">

        <com.lqr.optionitemview.OptionItemView
            android:id="@+id/notificationOptionItemView"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            app:left_image_margin_left="16dp"
            app:left_image_margin_right="12dp"
            app:left_src="@mipmap/ic_notification"
            app:left_text="消息通知"
            app:left_text_color="@color/ink"
            app:left_text_size="16sp" />

        <com.lqr.optionitemview.OptionItemView
            android:id="@+id/passwordOptionItemView"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"
            app:left_image_margin_left="16dp"
            app:left_image_margin_right="12dp"
            app:left_src="@mipmap/ic_account_setting"
            app:left_text="账号与安全"
            app:left_text_color="@color/ink"
            app:left_text_size="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="52dp"
            android:background="@color/fog" />

        <com.lqr.optionitemview.OptionItemView
            android:id="@+id/settintOptionItemView"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            app:left_image_margin_left="16dp"
            app:left_image_margin_right="12dp"
            app:left_src="@mipmap/me_press"
            app:left_text="@string/setting"
            app:left_text_color="@color/ink"
            app:left_text_size="16sp" />

    </LinearLayout>

</LinearLayout>
