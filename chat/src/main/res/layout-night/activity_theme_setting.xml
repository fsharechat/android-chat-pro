<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_setting_page_bg"
    android:orientation="vertical">

    <include layout="@layout/toolbar" />

    <!-- 当前模式显示 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/option_item_margin_top"
        android:background="@color/theme_setting_section_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前模式："
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/currentModeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="跟随系统"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/option_item_margin_top"
        android:background="@color/theme_setting_section_bg"
        android:orientation="vertical">

        <com.lqr.optionitemview.OptionItemView
            android:id="@+id/lightModeOptionItemView"
            style="@style/OptionItem"
            android:background="@drawable/selector_theme_setting_item"
            app:left_text="浅色模式"
            app:left_text_color="@color/theme_setting_item_text"
            app:left_text_margin_left="@dimen/option_item_margin_left"
            app:left_text_size="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/option_item_margin_top"
        android:background="@color/theme_setting_section_bg"
        android:orientation="vertical">

        <com.lqr.optionitemview.OptionItemView
            android:id="@+id/darkModeOptionItemView"
            style="@style/OptionItem"
            android:background="@drawable/selector_theme_setting_item"
            app:left_text="深色模式"
            app:left_text_color="@color/theme_setting_item_text"
            app:left_text_margin_left="@dimen/option_item_margin_left"
            app:left_text_size="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/option_item_margin_top"
        android:background="@color/theme_setting_section_bg"
        android:orientation="vertical">

        <com.lqr.optionitemview.OptionItemView
            android:id="@+id/systemModeOptionItemView"
            style="@style/OptionItem"
            android:background="@drawable/selector_theme_setting_item"
            app:left_text="跟随系统"
            app:left_text_color="@color/theme_setting_item_text"
            app:left_text_margin_left="@dimen/option_item_margin_left"
            app:left_text_size="16sp" />
    </LinearLayout>

</LinearLayout> 